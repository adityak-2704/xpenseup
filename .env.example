# ── XpenseUp — required environment variables ─────────────────────────────────
# Copy this file to .env.local for local development, and add the same two
# variables in Vercel under Project → Settings → Environment Variables.
#
# Find both in the Supabase dashboard: Project Settings → API.
#   * Project URL  → VITE_SUPABASE_URL
#   * anon public  → VITE_SUPABASE_ANON_KEY
#
# The anon key is meant to be public. It is shipped in the browser bundle and
# only grants what the row-level-security policies in supabase/schema.sql allow.
# Never put the `service_role` key here — that one bypasses RLS entirely.
#
# Vite only exposes variables prefixed with VITE_.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
